//@version=5
indicator("ローソク足パターン インジケーター 24本セット（買い＋売り）", overlay=true, max_labels_count=500)

// ============================================================
// ヘルパー変数
// ============================================================
bodySize    = math.abs(close - open)
totalRange  = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
isBull      = close >= open
isBear      = close < open
avgBody     = ta.sma(bodySize, 14)
avgRange    = ta.sma(totalRange, 14)

ema20       = ta.ema(close, 20)
ema50       = ta.ema(close, 50)
isUptrend   = ema20 > ema50
isDowntrend = ema20 < ema50

// ============================================================
// グループ設定
// ============================================================
GRP_BUY  = "─── 買いサイン（底値圏）───"
GRP_SELL = "─── 売りサイン（天井圏）───"

// ============================================================
// 買いサイン ON/OFF
// ============================================================
b_show1  = input.bool(true, "1. 陰の陰はらみ",          group=GRP_BUY)
b_show2  = input.bool(true, "2. 三手大黒線",             group=GRP_BUY)
b_show3  = input.bool(true, "3. 放れ七手の変化底",        group=GRP_BUY)
b_show4  = input.bool(true, "4. 最後の抱き線（底値圏）",  group=GRP_BUY)
b_show5  = input.bool(true, "5. 二本の差込線",           group=GRP_BUY)
b_show6  = input.bool(true, "6. 捨て子線（底値圏）",      group=GRP_BUY)
b_show7  = input.bool(true, "7. 鍋底",                  group=GRP_BUY)
b_show8  = input.bool(true, "8. 放れ五手黒一本底",        group=GRP_BUY)
b_show9  = input.bool(true, "9. 連続下げ三手放れ三ツ星",  group=GRP_BUY)
b_show10 = input.bool(true, "10. 陰の陽はらみ",          group=GRP_BUY)
b_show11 = input.bool(true, "11. たくり線",              group=GRP_BUY)
b_show12 = input.bool(true, "12. 陽線五本",              group=GRP_BUY)

// ============================================================
// 売りサイン ON/OFF
// ============================================================
s_show1  = input.bool(true, "1. 首吊り線",               group=GRP_SELL)
s_show2  = input.bool(true, "2. 三羽鳥",                 group=GRP_SELL)
s_show3  = input.bool(true, "3. 団子天井",               group=GRP_SELL)
s_show4  = input.bool(true, "4. 捨て子線（天井圏）",      group=GRP_SELL)
s_show5  = input.bool(true, "5. 陽の陽はらみ",           group=GRP_SELL)
s_show6  = input.bool(true, "6. 最後の抱き線（天井圏）",  group=GRP_SELL)
s_show7  = input.bool(true, "7. ツタイの打ち返し",        group=GRP_SELL)
s_show8  = input.bool(true, "8. 三手放れ寄せ線",          group=GRP_SELL)
s_show9  = input.bool(true, "9. 下げ足のかぶせ",          group=GRP_SELL)
s_show10 = input.bool(true, "10. 陽の陰はらみ",          group=GRP_SELL)
s_show11 = input.bool(true, "11. 波高い線",              group=GRP_SELL)
s_show12 = input.bool(true, "12. 陰線五本",              group=GRP_SELL)

// ============================================================
// ▼ 買いサイン パターン検出
// ============================================================
b1  = isBear[1] and isBear and bodySize[1] > avgBody and open < open[1] and open > close[1] and close < open[1] and close > close[1] and isDowntrend
b2  = isBear and isBear[1] and isBear[2] and bodySize > avgBody * 1.2 and bodySize[1] > avgBody * 1.2 and bodySize[2] > avgBody * 1.2 and close < close[1] and close[1] < close[2] and isDowntrend
b3  = isBear[1] and isBear[2] and isBear[3] and isBear[4] and isBear[5] and isBull and close > open[1]
b4  = isBear[1] and isBull and open <= close[1] and close >= open[1] and bodySize > bodySize[1] and isDowntrend
b5m = (open[1] + close[1]) / 2
b5  = isBear[1] and isBull and open < close[1] and close > b5m and close < open[1] and isDowntrend
b6d = math.abs(close[1] - open[1]) < avgRange * 0.1
b6  = isBear[2] and b6d and high[1] < low[2] and isBull and low > high[1]
b7l = ta.lowest(low, 5)
b7  = low[2] == b7l[2] and close > close[1] and close[1] > close[2] and low[3] > low[2] and low[4] > low[2]
b8  = isBear[1] and isBear[2] and isBear[3] and isBear[4] and isBear[5] and lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0
b9a = isBear[2] and bodySize[2] > avgBody * 1.2 and lowerShadow[2] > bodySize[2] * 0.5
b9b = isBear[1] and bodySize[1] < bodySize[2] and low[1] >= low[2] and high[1] <= high[2]
b9  = b9a and b9b and bodySize < avgBody * 0.5 and low >= low[1] and isDowntrend
b10 = isBear[1] and isBull and bodySize[1] > avgBody and open > close[1] and open < open[1] and close > close[1] and close < open[1] and isDowntrend
b11 = lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0 and totalRange > 0 and (math.min(open, close) - low) / totalRange > 0.55 and isDowntrend
b12 = isBull and isBull[1] and isBull[2] and isBull[3] and isBull[4] and close > close[1] and close[1] > close[2] and close[2] > close[3] and close[3] > close[4]

// ============================================================
// ▲ 売りサイン パターン検出
// ============================================================
s1  = lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0 and totalRange > 0 and (math.min(open, close) - low) / totalRange > 0.55 and isUptrend
s2  = isBear and isBear[1] and isBear[2] and open < open[1] and open > close[1] and open[1] < open[2] and open[1] > close[2] and close < close[1] and close[1] < close[2] and bodySize > avgBody * 0.8 and bodySize[1] > avgBody * 0.8 and bodySize[2] > avgBody * 0.8 and isUptrend
s3d = math.abs(close[1] - open[1]) < avgRange * 0.1
s3  = isBull[2] and s3d and low[1] > high[2] and isBear and close < (open[2] + close[2]) / 2
s4d = math.abs(close[1] - open[1]) < avgRange * 0.1
s4  = isBull[2] and s4d and low[1] > high[2] and isBear and high < low[1]
s5  = isBull[1] and isBull and bodySize[1] > avgBody and open > open[1] and open < close[1] and close < close[1] and close > open[1] and isUptrend
s6  = isBull[1] and isBear and open >= close[1] and close <= open[1] and bodySize > bodySize[1] and isUptrend
s7  = isBull[1] and isBear and math.abs(close - close[1]) < avgRange * 0.08 and bodySize > avgBody * 0.7 and bodySize[1] > avgBody * 0.7 and isUptrend
s8a = isBull[2] and bodySize[2] > avgBody * 1.2
s8b = isBear[1] and open[1] < close[2] and open[1] > open[2] and close[1] > open[2] and close[1] < close[2]
s8  = s8a and s8b and isBear and close < open[2] and isUptrend
s9m = (open[1] + close[1]) / 2
s9  = isBull[1] and isBear and open > close[1] and close < s9m and close > open[1] and isUptrend
s10 = isBull[1] and isBear and bodySize[1] > avgBody and open > open[1] and open < close[1] and close > open[1] and close < close[1] and isUptrend
s11 = upperShadow > bodySize * 2.0 and lowerShadow > bodySize * 2.0 and bodySize < avgBody * 0.5 and totalRange > avgRange * 1.5 and isUptrend
s12 = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4] and close < close[1] and close[1] < close[2] and close[2] < close[3] and close[3] < close[4]

// ============================================================
// ▼ 買いサイン ラベル表示（バー安値に直接固定）
// ============================================================
if b_show1 and b1
    label.new(bar_index, low, "①陰陰はらみ", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.blue, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show2 and b2
    label.new(bar_index, low, "②三手大黒", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.purple, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show3 and b3
    label.new(bar_index, low, "③放七変化底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.teal, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show4 and b4
    label.new(bar_index, low, "④抱き線底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.green, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show5 and b5
    label.new(bar_index, low, "⑤差込線", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.lime, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show6 and b6
    label.new(bar_index, low, "⑥捨子線底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.orange, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show7 and b7
    label.new(bar_index, low, "⑦鍋底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.yellow, 0), style=label.style_label_up, textcolor=color.black, size=size.small)
if b_show8 and b8
    label.new(bar_index, low, "⑧放五黒底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.navy, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show9 and b9
    label.new(bar_index, low, "⑨三ツ星底", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.aqua, 0), style=label.style_label_up, textcolor=color.black, size=size.small)
if b_show10 and b10
    label.new(bar_index, low, "⑩陰陽はらみ", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.green, 30), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show11 and b11
    label.new(bar_index, low, "⑪たくり線", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.red, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if b_show12 and b12
    label.new(bar_index, low, "⑫陽線五本", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.fuchsia, 0), style=label.style_label_up, textcolor=color.white, size=size.small)

// ============================================================
// ▲ 売りサイン ラベル表示（バー高値に直接固定）
// ============================================================
if s_show1 and s1
    label.new(bar_index, high, "①首吊線", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.red, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show2 and s2
    label.new(bar_index, high, "②三羽鳥", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.maroon, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show3 and s3
    label.new(bar_index, high, "③団子天井", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.orange, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show4 and s4
    label.new(bar_index, high, "④捨子線天", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.purple, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show5 and s5
    label.new(bar_index, high, "⑤陽陽はらみ", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.blue, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show6 and s6
    label.new(bar_index, high, "⑥抱き線天", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.red, 20), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show7 and s7
    label.new(bar_index, high, "⑦打ち返し", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.teal, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show8 and s8
    label.new(bar_index, high, "⑧三手放れ", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.navy, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show9 and s9
    label.new(bar_index, high, "⑨かぶせ線", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.black, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show10 and s10
    label.new(bar_index, high, "⑩陽陰はらみ", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.red, 30), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show11 and s11
    label.new(bar_index, high, "⑪波高線", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.gray, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if s_show12 and s12
    label.new(bar_index, high, "⑫陰線五本", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.maroon, 20), style=label.style_label_down, textcolor=color.white, size=size.small)

// ============================================================
// 背景色
// ============================================================
bgcolor(isUptrend   ? color.new(color.red,  97) : na, title="上昇トレンド背景（赤）")
bgcolor(isDowntrend ? color.new(color.blue, 97) : na, title="下降トレンド背景（青）")
