//@version=5
indicator("売りサイン（天井圏）インジケーター 12本セット", overlay=true, max_labels_count=500)

// ============================================================
// ヘルパー変数
// ============================================================
bodySize    = math.abs(close - open)
totalRange  = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
isBull      = close >= open
isBear      = close < open
avgBody     = ta.sma(bodySize, 14)
avgRange    = ta.sma(totalRange, 14)

ema20     = ta.ema(close, 20)
ema50     = ta.ema(close, 50)
isUptrend = ema20 > ema50

// ============================================================
// 表示ON/OFF切り替え
// ============================================================
show1  = input.bool(true, "1. 首吊り線")
show2  = input.bool(true, "2. 三羽鳥")
show3  = input.bool(true, "3. 団子天井")
show4  = input.bool(true, "4. 捨て子線（上げから安値寄り）")
show5  = input.bool(true, "5. 陽の陽はらみ")
show6  = input.bool(true, "6. 最後の抱き線／包み線（天井圏）")
show7  = input.bool(true, "7. ツタイの打ち返し")
show8  = input.bool(true, "8. 三手放れ寄せ線")
show9  = input.bool(true, "9. 下げ足のかぶせ")
show10 = input.bool(true, "10. 陽の陰はらみ")
show11 = input.bool(true, "11. 波高い線")
show12 = input.bool(true, "12. 陰線五本")

// ============================================================
// パターン検出
// ============================================================
s1  = lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0 and totalRange > 0 and (math.min(open, close) - low) / totalRange > 0.55 and isUptrend
s2  = isBear and isBear[1] and isBear[2] and open < open[1] and open > close[1] and open[1] < open[2] and open[1] > close[2] and close < close[1] and close[1] < close[2] and bodySize > avgBody * 0.8 and bodySize[1] > avgBody * 0.8 and bodySize[2] > avgBody * 0.8 and isUptrend
s3d = math.abs(close[1] - open[1]) < avgRange * 0.1
s3  = isBull[2] and s3d and low[1] > high[2] and isBear and close < (open[2] + close[2]) / 2
s4d = math.abs(close[1] - open[1]) < avgRange * 0.1
s4  = isBull[2] and s4d and low[1] > high[2] and isBear and high < low[1]
s5  = isBull[1] and isBull and bodySize[1] > avgBody and open > open[1] and open < close[1] and close < close[1] and close > open[1] and isUptrend
s6  = isBull[1] and isBear and open >= close[1] and close <= open[1] and bodySize > bodySize[1] and isUptrend
s7  = isBull[1] and isBear and math.abs(close - close[1]) < avgRange * 0.08 and bodySize > avgBody * 0.7 and bodySize[1] > avgBody * 0.7 and isUptrend
s8a = isBull[2] and bodySize[2] > avgBody * 1.2
s8b = isBear[1] and open[1] < close[2] and open[1] > open[2] and close[1] > open[2] and close[1] < close[2]
s8  = s8a and s8b and isBear and close < open[2] and isUptrend
s9m = (open[1] + close[1]) / 2
s9  = isBull[1] and isBear and open > close[1] and close < s9m and close > open[1] and isUptrend
s10 = isBull[1] and isBear and bodySize[1] > avgBody and open > open[1] and open < close[1] and close > open[1] and close < close[1] and isUptrend
s11 = upperShadow > bodySize * 2.0 and lowerShadow > bodySize * 2.0 and bodySize < avgBody * 0.5 and totalRange > avgRange * 1.5 and isUptrend
s12 = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4] and close < close[1] and close[1] < close[2] and close[2] < close[3] and close[3] < close[4]

// ============================================================
// ラベル表示（yloc.abovebar でバー上に相対固定）
// ============================================================
if show1 and s1
    label.new(bar_index, na, "①首吊線", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.red, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show2 and s2
    label.new(bar_index, na, "②三羽鳥", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.maroon, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show3 and s3
    label.new(bar_index, na, "③団子天井", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.orange, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show4 and s4
    label.new(bar_index, na, "④捨子線天", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.purple, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show5 and s5
    label.new(bar_index, na, "⑤陽陽はらみ", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.blue, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show6 and s6
    label.new(bar_index, na, "⑥抱き線天", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.red, 20), style=label.style_label_down, textcolor=color.white, size=size.small)
if show7 and s7
    label.new(bar_index, na, "⑦打ち返し", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.teal, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show8 and s8
    label.new(bar_index, na, "⑧三手放れ", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.navy, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show9 and s9
    label.new(bar_index, na, "⑨かぶせ線", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.black, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show10 and s10
    label.new(bar_index, na, "⑩陽陰はらみ", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.red, 30), style=label.style_label_down, textcolor=color.white, size=size.small)
if show11 and s11
    label.new(bar_index, na, "⑪波高線", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.gray, 0), style=label.style_label_down, textcolor=color.white, size=size.small)
if show12 and s12
    label.new(bar_index, na, "⑫陰線五本", xloc=xloc.bar_index, yloc=yloc.abovebar, color=color.new(color.maroon, 20), style=label.style_label_down, textcolor=color.white, size=size.small)

// ============================================================
// 背景色
// ============================================================
bgcolor(isUptrend ? color.new(color.red, 95) : na, title="上昇トレンド背景")
