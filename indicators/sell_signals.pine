//@version=5
indicator("売りサイン（天井圏）インジケーター 12本セット", overlay=true, max_labels_count=500)

// ============================================================
// ヘルパー変数
// ============================================================
bodySize    = math.abs(close - open)
totalRange  = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
isBull      = close >= open
isBear      = close < open
avgBody     = ta.sma(bodySize, 14)
avgRange    = ta.sma(totalRange, 14)

ema20     = ta.ema(close, 20)
ema50     = ta.ema(close, 50)
isUptrend = ema20 > ema50

// ============================================================
// 表示ON/OFF切り替え
// ============================================================
show1  = input.bool(true, "1. 首吊り線")
show2  = input.bool(true, "2. 三羽鳥")
show3  = input.bool(true, "3. 団子天井")
show4  = input.bool(true, "4. 捨て子線（上げから安値寄り）")
show5  = input.bool(true, "5. 陽の陽はらみ")
show6  = input.bool(true, "6. 最後の抱き線／包み線（天井圏）")
show7  = input.bool(true, "7. ツタイの打ち返し")
show8  = input.bool(true, "8. 三手放れ寄せ線")
show9  = input.bool(true, "9. 下げ足のかぶせ")
show10 = input.bool(true, "10. 陽の陰はらみ")
show11 = input.bool(true, "11. 波高い線")
show12 = input.bool(true, "12. 陰線五本")

// ============================================================
// 1. 首吊り線（ハンギングマン）
// ============================================================
kubitsuri = lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0 and totalRange > 0 and (math.min(open, close) - low) / totalRange > 0.55 and isUptrend
plotshape(show1 and kubitsuri, title="首吊り線", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="①\n首吊線", textcolor=color.white, size=size.small)

// ============================================================
// 2. 三羽鳥（スリーブラッククロウズ）
// ============================================================
sanba = isBear and isBear[1] and isBear[2] and open < open[1] and open > close[1] and open[1] < open[2] and open[1] > close[2] and close < close[1] and close[1] < close[2] and bodySize > avgBody * 0.8 and bodySize[1] > avgBody * 0.8 and bodySize[2] > avgBody * 0.8 and isUptrend
plotshape(show2 and sanba, title="三羽鳥", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 0), text="②\n三羽鳥", textcolor=color.white, size=size.small)

// ============================================================
// 3. 団子天井（宵の明星・イブニングドジスター）
// ============================================================
dg3_doji  = math.abs(close[1] - open[1]) < avgRange * 0.1
dg3_gapU  = low[1] > high[2]
dangoTop  = isBull[2] and dg3_doji and dg3_gapU and isBear and close < (open[2] + close[2]) / 2
plotshape(show3 and dangoTop, title="団子天井", style=shape.labeldown, location=location.abovebar, color=color.new(color.orange, 0), text="③\n団子天井", textcolor=color.white, size=size.small)

// ============================================================
// 4. 捨て子線（上げから安値寄り）
// ============================================================
sg4_doji  = math.abs(close[1] - open[1]) < avgRange * 0.1
sg4_gapU  = low[1] > high[2]
sg4_gapD  = high < low[1]
sutegoTop = isBull[2] and sg4_doji and sg4_gapU and isBear and sg4_gapD
plotshape(show4 and sutegoTop, title="捨て子線（天井圏）", style=shape.labeldown, location=location.abovebar, color=color.new(color.purple, 0), text="④\n捨子線天", textcolor=color.white, size=size.small)

// ============================================================
// 5. 陽の陽はらみ（天井圏の陽のはらみ線）
// ============================================================
youYouHarami = isBull[1] and isBull and bodySize[1] > avgBody and open > open[1] and open < close[1] and close < close[1] and close > open[1] and isUptrend
plotshape(show5 and youYouHarami, title="陽の陽はらみ", style=shape.labeldown, location=location.abovebar, color=color.new(color.blue, 0), text="⑤\n陽陽はらみ", textcolor=color.white, size=size.small)

// ============================================================
// 6. 最後の抱き線／包み線（天井圏）
// ============================================================
saigoT = isBull[1] and isBear and open >= close[1] and close <= open[1] and bodySize > bodySize[1] and isUptrend
plotshape(show6 and saigoT, title="最後の抱き線（天井圏）", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 20), text="⑥\n抱き線天", textcolor=color.white, size=size.small)

// ============================================================
// 7. ツタイの打ち返し（切り返し線・逆撃線）
// ============================================================
tsutai = isBull[1] and isBear and math.abs(close - close[1]) < avgRange * 0.08 and bodySize > avgBody * 0.7 and bodySize[1] > avgBody * 0.7 and isUptrend
plotshape(show7 and tsutai, title="ツタイの打ち返し", style=shape.labeldown, location=location.abovebar, color=color.new(color.teal, 0), text="⑦\n打ち返し", textcolor=color.white, size=size.small)

// ============================================================
// 8. 三手放れ寄せ線（スリーインサイドダウン）
// ============================================================
sc8_c1 = isBull[2] and bodySize[2] > avgBody * 1.2
sc8_c2 = isBear[1] and open[1] < close[2] and open[1] > open[2] and close[1] > open[2] and close[1] < close[2]
sc8_c3 = isBear and close < open[2]
santeHanare = sc8_c1 and sc8_c2 and sc8_c3 and isUptrend
plotshape(show8 and santeHanare, title="三手放れ寄せ線", style=shape.labeldown, location=location.abovebar, color=color.new(color.navy, 0), text="⑧\n三手放れ", textcolor=color.white, size=size.small)

// ============================================================
// 9. 下げ足のかぶせ（ダーククラウドカバー）
// ============================================================
midC1_sell = (open[1] + close[1]) / 2
darkCloud  = isBull[1] and isBear and open > close[1] and close < midC1_sell and close > open[1] and isUptrend
plotshape(show9 and darkCloud, title="下げ足のかぶせ", style=shape.labeldown, location=location.abovebar, color=color.new(color.black, 0), text="⑨\nかぶせ線", textcolor=color.white, size=size.small)

// ============================================================
// 10. 陽の陰はらみ（弱気のはらみ線）
// ============================================================
youYinHarami = isBull[1] and isBear and bodySize[1] > avgBody and open > open[1] and open < close[1] and close > open[1] and close < close[1] and isUptrend
plotshape(show10 and youYinHarami, title="陽の陰はらみ", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 30), text="⑩\n陽陰はらみ", textcolor=color.white, size=size.small)

// ============================================================
// 11. 波高い線（ハイウェーブキャンドル）
// ============================================================
namiTakai = upperShadow > bodySize * 2.0 and lowerShadow > bodySize * 2.0 and bodySize < avgBody * 0.5 and totalRange > avgRange * 1.5 and isUptrend
plotshape(show11 and namiTakai, title="波高い線", style=shape.labeldown, location=location.abovebar, color=color.new(color.gray, 0), text="⑪\n波高線", textcolor=color.white, size=size.small)

// ============================================================
// 12. 陰線五本
// ============================================================
insenGohon = isBear and isBear[1] and isBear[2] and isBear[3] and isBear[4] and close < close[1] and close[1] < close[2] and close[2] < close[3] and close[3] < close[4]
plotshape(show12 and insenGohon, title="陰線五本", style=shape.labeldown, location=location.abovebar, color=color.new(color.maroon, 20), text="⑫\n陰線五本", textcolor=color.white, size=size.small)

// ============================================================
// 背景色
// ============================================================
bgcolor(isUptrend ? color.new(color.red, 95) : na, title="上昇トレンド背景")
