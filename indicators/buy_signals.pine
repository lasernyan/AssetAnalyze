//@version=5
indicator("買いサイン（底値圏）インジケーター 12本セット", overlay=true, max_labels_count=500)

// ============================================================
// ヘルパー変数
// ============================================================
bodySize    = math.abs(close - open)
totalRange  = high - low
upperShadow = high - math.max(open, close)
lowerShadow = math.min(open, close) - low
isBull      = close >= open
isBear      = close < open
avgBody     = ta.sma(bodySize, 14)
avgRange    = ta.sma(totalRange, 14)

ema20       = ta.ema(close, 20)
ema50       = ta.ema(close, 50)
isDowntrend = ema20 < ema50

// ============================================================
// 表示ON/OFF切り替え
// ============================================================
show1  = input.bool(true, "1. 陰の陰はらみ")
show2  = input.bool(true, "2. 三手大黒線")
show3  = input.bool(true, "3. 放れ七手の変化底")
show4  = input.bool(true, "4. 最後の抱き線／包み線（底値圏）")
show5  = input.bool(true, "5. 二本の差込線")
show6  = input.bool(true, "6. 捨て子線（下げから高値寄り）")
show7  = input.bool(true, "7. 鍋底")
show8  = input.bool(true, "8. 放れ五手黒一本底")
show9  = input.bool(true, "9. 連続下げ三手放れ三ツ星")
show10 = input.bool(true, "10. 陰の陽はらみ")
show11 = input.bool(true, "11. たくり線")
show12 = input.bool(true, "12. 陽線五本")

// ============================================================
// パターン検出
// ============================================================
b1  = isBear[1] and isBear and bodySize[1] > avgBody and open < open[1] and open > close[1] and close < open[1] and close > close[1] and isDowntrend
b2  = isBear and isBear[1] and isBear[2] and bodySize > avgBody * 1.2 and bodySize[1] > avgBody * 1.2 and bodySize[2] > avgBody * 1.2 and close < close[1] and close[1] < close[2] and isDowntrend
b3  = isBear[1] and isBear[2] and isBear[3] and isBear[4] and isBear[5] and isBull and close > open[1]
b4  = isBear[1] and isBull and open <= close[1] and close >= open[1] and bodySize > bodySize[1] and isDowntrend
b5m = (open[1] + close[1]) / 2
b5  = isBear[1] and isBull and open < close[1] and close > b5m and close < open[1] and isDowntrend
b6d = math.abs(close[1] - open[1]) < avgRange * 0.1
b6  = isBear[2] and b6d and high[1] < low[2] and isBull and low > high[1]
b7l = ta.lowest(low, 5)
b7  = low[2] == b7l[2] and close > close[1] and close[1] > close[2] and low[3] > low[2] and low[4] > low[2]
b8  = isBear[1] and isBear[2] and isBear[3] and isBear[4] and isBear[5] and lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0
b9a = isBear[2] and bodySize[2] > avgBody * 1.2 and lowerShadow[2] > bodySize[2] * 0.5
b9b = isBear[1] and bodySize[1] < bodySize[2] and low[1] >= low[2] and high[1] <= high[2]
b9  = b9a and b9b and bodySize < avgBody * 0.5 and low >= low[1] and isDowntrend
b10 = isBear[1] and isBull and bodySize[1] > avgBody and open > close[1] and open < open[1] and close > close[1] and close < open[1] and isDowntrend
b11 = lowerShadow > bodySize * 2.0 and upperShadow < bodySize * 0.5 and bodySize > 0 and totalRange > 0 and (math.min(open, close) - low) / totalRange > 0.55 and isDowntrend
b12 = isBull and isBull[1] and isBull[2] and isBull[3] and isBull[4] and close > close[1] and close[1] > close[2] and close[2] > close[3] and close[3] > close[4]

// ============================================================
// ラベル表示（yloc.belowbar でバー下に相対固定）
// ============================================================
if show1 and b1
    label.new(bar_index, na, "①陰陰はらみ", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.blue, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show2 and b2
    label.new(bar_index, na, "②三手大黒", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.purple, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show3 and b3
    label.new(bar_index, na, "③放七変化底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.teal, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show4 and b4
    label.new(bar_index, na, "④抱き線底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.green, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show5 and b5
    label.new(bar_index, na, "⑤差込線", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.lime, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show6 and b6
    label.new(bar_index, na, "⑥捨子線底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.orange, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show7 and b7
    label.new(bar_index, na, "⑦鍋底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.yellow, 0), style=label.style_label_up, textcolor=color.black, size=size.small)
if show8 and b8
    label.new(bar_index, na, "⑧放五黒底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.navy, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show9 and b9
    label.new(bar_index, na, "⑨三ツ星底", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.aqua, 0), style=label.style_label_up, textcolor=color.black, size=size.small)
if show10 and b10
    label.new(bar_index, na, "⑩陰陽はらみ", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.green, 30), style=label.style_label_up, textcolor=color.white, size=size.small)
if show11 and b11
    label.new(bar_index, na, "⑪たくり線", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.red, 0), style=label.style_label_up, textcolor=color.white, size=size.small)
if show12 and b12
    label.new(bar_index, na, "⑫陽線五本", xloc=xloc.bar_index, yloc=yloc.belowbar, color=color.new(color.fuchsia, 0), style=label.style_label_up, textcolor=color.white, size=size.small)

// ============================================================
// 背景色
// ============================================================
bgcolor(isDowntrend ? color.new(color.blue, 95) : na, title="下降トレンド背景")
